# GhostTrace Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Application Environment: development, production, testing
GHOSTTRACE_ENV=development

# Enable debug logging and verbose diagnostics
GHOSTTRACE_DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
GHOSTTRACE_LOG_LEVEL=INFO

# Directory paths (leave empty or uncomment to use sensible defaults)
# Default App Data on Windows: %LOCALAPPDATA%\GhostTrace
# GHOSTTRACE_APP_DATA_DIR=C:\Users\<YourUsername>\AppData\Local\GhostTrace

# Default Log Directory: %LOCALAPPDATA%\GhostTrace\logs
# GHOSTTRACE_LOG_DIR=C:\Users\<YourUsername>\AppData\Local\GhostTrace\logs

# Default Database Directory: %LOCALAPPDATA%\GhostTrace\db
# GHOSTTRACE_DB_DIR=C:\Users\<YourUsername>\AppData\Local\GhostTrace\db

# Default Local Model Directory: .\models
# GHOSTTRACE_MODEL_DIR=D:\GhostTrace\models
