# GhostTrace Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Application Environment: development, production, testing
GHOSTTRACE_ENV=development

# Enable debug logging and verbose diagnostics
GHOSTTRACE_DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
GHOSTTRACE_LOG_LEVEL=INFO

# Directory paths (leave empty or uncomment to use sensible defaults)
# Default App Data on Windows: %LOCALAPPDATA%\GhostTrace
# GHOSTTRACE_APP_DATA_DIR=C:\Users\<YourUsername>\AppData\Local\GhostTrace

# Default Log Directory: %LOCALAPPDATA%\GhostTrace\logs
# GHOSTTRACE_LOG_DIR=C:\Users\<YourUsername>\AppData\Local\GhostTrace\logs

# Default Database Directory: %LOCALAPPDATA%\GhostTrace\db
# GHOSTTRACE_DB_DIR=C:\Users\<YourUsername>\AppData\Local\GhostTrace\db

# Default Local Model Directory: .\models
# GHOSTTRACE_MODEL_DIR=D:\GhostTrace\models

# Local AI Subsystem Configuration (Step 03)
# Explicit path to GGUF model weights (defaults to models/qwen2.5-1.5b-instruct-q4_k_m.gguf)
# GHOSTTRACE_MODEL_PATH=D:\GhostTrace\models\qwen2.5-1.5b-instruct-q4_k_m.gguf
GHOSTTRACE_AI_ENABLED=true
GHOSTTRACE_AI_CONTEXT_SIZE=2048
GHOSTTRACE_AI_MAX_TOKENS=512
GHOSTTRACE_AI_TEMPERATURE=0.7
GHOSTTRACE_AI_TOP_P=0.9
GHOSTTRACE_AI_THREADS=2
GHOSTTRACE_AI_GPU_LAYERS=0
GHOSTTRACE_AI_BATCH_SIZE=128
GHOSTTRACE_AI_HISTORY_LIMIT=10

# Ghost Personality & Behaviour Engine Configuration (Step 04)
# Enable or disable ghost personality layer (false = neutral developer assistant)
GHOSTTRACE_GHOST_ENABLED=true

# Active personality profile: forgotten-machine, phantom-coder, guardian-spirit
GHOSTTRACE_GHOST_PROFILE=forgotten-machine

# Enable or disable session mood tracking and contextual transitions
GHOSTTRACE_GHOST_MOOD_ENABLED=true

# Developer Intelligence & Coding Assistance Configuration (Step 05)
# Enable or disable developer assistance subsystem
GHOSTTRACE_DEV_ENABLED=true

# Enable or disable safe local static analysis on user-supplied code
GHOSTTRACE_DEV_STATIC_ANALYSIS=true

# Maximum character limits to prevent memory exhaustion
GHOSTTRACE_DEV_MAX_CODE_CHARS=20000
GHOSTTRACE_DEV_MAX_CONTEXT_CHARS=30000

# Command Guardian & Execution Safety (Step 06)
# Enable or disable Command Guardian subsystem
GHOSTTRACE_GUARD_ENABLED=true

# Enable or disable controlled command execution (false = analysis-only mode)
GHOSTTRACE_GUARD_EXECUTION_ENABLED=true

# Require explicit user approval before every command execution (strictly enforced)
GHOSTTRACE_GUARD_REQUIRE_APPROVAL=true

# Default execution timeout in seconds (1 - 120s)
GHOSTTRACE_GUARD_TIMEOUT_SECONDS=30

# Maximum configurable timeout in seconds (1 - 600s)
GHOSTTRACE_GUARD_MAX_TIMEOUT_SECONDS=120

# Maximum output characters captured per execution (stdout & stderr)
GHOSTTRACE_GUARD_MAX_OUTPUT_CHARS=12000

# Maximum session execution records retained in memory (1 - 500)
GHOSTTRACE_GUARD_HISTORY_LIMIT=50

# Block execution of high-risk commands by default
GHOSTTRACE_GUARD_BLOCK_HIGH_RISK=true

# Strictly block dangerous and malicious commands
GHOSTTRACE_GUARD_BLOCKED_COMMANDS_ENABLED=true

# Persistent Memory & Project Context (Step 07)
# Enable or disable persistent memory subsystem
GHOSTTRACE_MEMORY_ENABLED=true

# Persist conversation sessions and message history
GHOSTTRACE_MEMORY_PERSIST_CONVERSATIONS=true

# Maximum memory items retained in database
GHOSTTRACE_MEMORY_MAX_ITEMS=500

# Maximum session conversation messages retained in database
GHOSTTRACE_MEMORY_MAX_MESSAGES=2000

# Maximum character length per memory item content
GHOSTTRACE_MEMORY_MAX_CONTENT_CHARS=4000

# Maximum character budget for retrieved memories injected into prompt
GHOSTTRACE_MEMORY_MAX_CONTEXT_CHARS=1500

# Maximum memory items retrieved per query
GHOSTTRACE_MEMORY_MAX_RETRIEVED=5

# Retention days for session conversations (0 = retain indefinitely)
GHOSTTRACE_MEMORY_RETENTION_DAYS=90

# Enable or disable project context discovery and indexing
GHOSTTRACE_PROJECT_ENABLED=true

# Maximum files indexed per registered project
GHOSTTRACE_PROJECT_MAX_FILES=200

# Maximum file size in bytes indexed into database (default: 256 KB)
GHOSTTRACE_PROJECT_MAX_FILE_BYTES=262144

# Maximum total bytes indexed per project (default: 5 MB)
GHOSTTRACE_PROJECT_MAX_TOTAL_BYTES=5242880

# Maximum directory traversal depth for project scanning
GHOSTTRACE_PROJECT_MAX_DEPTH=6

# Maximum character budget for project file context injected into prompt
GHOSTTRACE_PROJECT_MAX_CONTEXT_CHARS=2000

# Maximum total character budget for all injected context combined
GHOSTTRACE_CONTEXT_MAX_TOTAL_CHARS=3000

# Optional custom SQLite database path (defaults to %LOCALAPPDATA%\GhostTrace\db\ghosttrace.db)
# GHOSTTRACE_MEMORY_DATABASE_PATH=C:\Users\<YourUsername>\AppData\Local\GhostTrace\db\ghosttrace.db



